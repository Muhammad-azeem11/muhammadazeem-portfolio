# ============================================================
# .env.local.example
# Muhammad Azeem Portfolio — Environment Variables Template
# ------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# NEVER put API keys in frontend code.
# ============================================================

# ── Site ─────────────────────────────────────────────────────
# Public URL of the deployed site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── NextAuth (Auth.js v5) ─────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# Auth URL (required in some deployment environments)
# AUTH_URL=https://yourdomain.com

# ── Google OAuth (for admin login) ───────────────────────────
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin Credentials (Credentials provider) ─────────────────
# Temporary admin login — replace with DB-backed auth in CMS phase
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# Comma-separated list of Google emails allowed to access admin
ADMIN_ALLOWED_EMAILS=admin@example.com

# ── Database (PostgreSQL) — used in CMS phase ─────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/portfolio

# ── CMS / Payload (when integrated) ──────────────────────────
# PAYLOAD_SECRET=your-payload-secret

# ── Analytics (when integrated) ──────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Booking (Calendly/Cal.com) ───────────────────────────────
# NEXT_PUBLIC_BOOKING_URL=https://cal.com/muhammadazeem

# ── Email (for contact form) ─────────────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Object Storage (Optional Vercel Blob for PNG Screenshots) ─
# By default, generated testimonial PNGs are stored in the database
# and served at /api/screenshots/[filename]. Set BLOB_READ_WRITE_TOKEN
# to also mirror assets to Vercel Blob storage in production.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
